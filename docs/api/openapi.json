  "info": {
    "title": "Kariakoo Shop Manager API",
    "description": "Versioned REST API. Errors use RFC 9457 problem details.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ksm_session"
      }
    },
    "schemas": {
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "timestamp"
        ]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "database"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "checks",
          "timestamp"
        ]
      },
      "SetRolesDto": {
        "type": "object",
        "properties": {
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "roleIds"
        ]
      },
      "SetStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SetOwnerDto": {
        "type": "object",
        "properties": {
          "isOwner": {
            "type": "boolean"
          }
        },
        "required": [
          "isOwner"
        ]
      },
      "RoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dashboard.read",
                "products.read",
                "products.create",
                "products.update",
                "products.archive",
                "products.prices.update",
                "inventory.read",
                "inventory.adjust",
                "inventory.opening",
                "suppliers.read",
                "suppliers.manage",
                "purchases.read",
                "purchases.create",
                "purchases.receive",
                "purchases.cancel",
                "supplier_payments.create",
                "sales.read",
                "sales.read_all",
                "sales.create",
                "sales.discount",
                "sales.credit",
                "sales.refund",
                "sales.void",
                "customers.read",
                "customers.manage",
                "customers.credit.manage",
                "expenses.read",
                "expenses.create",
                "expenses.void",
                "cash_sessions.open",
                "cash_sessions.close",
                "cash_sessions.review",
                "reports.read",
                "reports.profit.read",
                "reports.export",
                "users.read",
                "users.invite",
                "users.manage",
                "roles.manage",
                "audit.read",
                "subscription.read",
                "subscription.manage",
                "settings.manage",
                "devices.manage"
              ]
            }
          }
        },
        "required": [
          "name",
          "permissions"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "fullName",
          "email",
          "password"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "SwitchShopDto": {
        "type": "object",
        "properties": {
          "shopId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "shopId"
        ]
      },
      "CreateShopDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "maxLength": 32
          },
          "address": {
            "type": "string",
            "maxLength": 255
          },
          "businessType": {
            "type": "string",
            "enum": [
              "WHOLESALE",
              "RETAIL",
              "BOTH"
            ],
            "default": "BOTH"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateShopDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "maxLength": 32
          },
          "address": {
            "type": "string",
            "maxLength": 255
          },
          "businessType": {
            "type": "string",
            "enum": [
              "WHOLESALE",
              "RETAIL",
              "BOTH"
            ],
            "default": "BOTH"
          }
        }
      },
      "CreateInvitationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "email",
          "roleIds"
        ]
      },
      "InvitationTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      }
    }
  }
}
