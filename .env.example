# Copy to .env for local development: cp .env.example .env
# Every value here is a safe local placeholder. Never commit real secrets.

# ---- Shared ----
NODE_ENV=development

# ---- PostgreSQL (used by docker compose) ----
POSTGRES_USER=ksm
POSTGRES_PASSWORD=ksm_local_password
POSTGRES_DB=ksm
POSTGRES_PORT=5432

# ---- API (backend) ----
# Port the NestJS API listens on.
PORT=4000
# Connection string Prisma and the API use. In docker compose the API overrides
# the host with "postgres".
DATABASE_URL=postgresql://ksm:ksm_local_password@localhost:5432/ksm?schema=public
# Origin of the web app, used for CORS. Comma-separate several origins.
WEB_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Serve Swagger UI at /api/docs (keep false in production).
SWAGGER_ENABLED=true

# ---- Web (Next.js) ----
# Where the Next.js server forwards /api/* requests. Server-side only.
API_INTERNAL_URL=http://localhost:4000

# ---- Sessions ----
# Base URL used in email links (defaults to the first WEB_ORIGIN).
APP_URL=http://localhost:3000
# Session cookie only over HTTPS (defaults to true when NODE_ENV=production).
COOKIE_SECURE=false
# Sign out after this many idle hours, and this many days after sign-in.
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
# Proxies in front of the API whose X-Forwarded-For is trusted for client IPs.
# The web app's /api forwarding counts as one.
TRUST_PROXY=1

# ---- Mail (Mailpit catches everything locally: http://localhost:8025) ----
# smtp | memory (tests only; refused in production) | log (subject only)
MAIL_TRANSPORT=smtp
MAIL_FROM=Kariakoo Shop Manager <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Leave empty for Mailpit. Set real provider credentials only outside the repo.
SMTP_USER=
SMTP_PASSWORD=

# ---- Outbox worker (delivers queued email with retries) ----
# Turn off only when another process runs the worker.
OUTBOX_WORKER=on
OUTBOX_POLL_MS=1000

# ---- Staff ----
# Maximum members plus pending invitations per shop until plans define seats
# (Phase 04). Leave empty for no limit.
SEAT_LIMIT=

# ---- Automated browser tests only ----
# Multiplies every rate limit because all simulated users share one address.
# Keep at 1 for development and production.
RATE_LIMIT_MULTIPLIER=1
