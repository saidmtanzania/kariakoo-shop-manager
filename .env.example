# Copy to .env for local development: cp .env.example .env
# Every value here is a safe local placeholder. Never commit real secrets.

# ---- Shared ----
NODE_ENV=development

# ---- PostgreSQL (used by docker compose) ----
POSTGRES_USER=ksm
POSTGRES_PASSWORD=ksm_local_password
POSTGRES_DB=ksm
POSTGRES_PORT=5432

# ---- API (backend) ----
# Port the NestJS API listens on.
PORT=4000
# Connection string Prisma and the API use. In docker compose the API overrides
# the host with "postgres".
DATABASE_URL=postgresql://ksm:ksm_local_password@localhost:5432/ksm?schema=public
# Origin of the web app, used for CORS. Comma-separate several origins.
WEB_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Serve Swagger UI at /api/docs (keep false in production).
SWAGGER_ENABLED=true

# ---- Web (Next.js) ----
# Where the Next.js server forwards /api/* requests. Server-side only.
API_INTERNAL_URL=http://localhost:4000

# ---- Mail (mailpit in docker compose; used from Phase 02) ----
SMTP_HOST=localhost
SMTP_PORT=1025
