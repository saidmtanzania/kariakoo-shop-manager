// Kariakoo Shop Manager database schema.
//
// Tables are added phase by phase from docs/architecture/data-model.md.
// Conventions (docs/decisions/decision-register.md, A-008 and D-021):
//   - ids: uuid (v7, generated by the API)
//   - money: Decimal @db.Decimal(18, 2); average cost @db.Decimal(18, 4)
//   - quantities: Decimal @db.Decimal(18, 3)
//   - every shop-owned table has shop_id

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity and tenancy (Phase 02). docs/architecture/data-model.md section 2.
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Global identity. Not shop-scoped: one person, many shop memberships.
model User {
  id              String     @id @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name") @db.VarChar(120)
  phone           String?    @db.VarChar(32)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(ACTIVE)
  /// Platform operators only; never grantable through shop APIs.
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  authTokens  AuthToken[]
  memberships ShopMembership[]

  @@map("users")
}

/// Server-side session (decision A-003). Only the SHA-256 hash of the cookie
/// token is stored.
model Session {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  /// Set only after the server validated an ACTIVE membership.
  activeShopId  String?   @map("active_shop_id") @db.Uuid
  ip            String?   @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeShop Shop? @relation(fields: [activeShopId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Single-use, time-limited tokens sent by email. Stored as SHA-256 hashes.
model AuthToken {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

enum BusinessType {
  WHOLESALE
  RETAIL
  BOTH
}

enum ShopStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
}

/// The tenant. Every shop-owned table references it through shop_id.
model Shop {
  id           String       @id @db.Uuid
  name         String       @db.VarChar(120)
  phone        String?      @db.VarChar(32)
  address      String?      @db.VarChar(255)
  businessType BusinessType @default(BOTH) @map("business_type")
  timezone     String       @default("Africa/Dar_es_Salaam") @db.VarChar(64)
  currency     String       @default("TZS") @db.Char(3)
  status       ShopStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships ShopMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]

  @@map("shops")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model ShopMembership {
  id        String           @id @db.Uuid
  shopId    String           @map("shop_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  isOwner   Boolean          @default(false) @map("is_owner")
  joinedAt  DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([shopId, userId])
  // Target for composite foreign keys (shop_id, membership_id) in later phases.
  @@unique([shopId, id])
  @@index([userId])
  @@map("shop_memberships")
}

// ---------------------------------------------------------------------------
// Reliability and auditing
// ---------------------------------------------------------------------------

/// Append-only record of security-relevant actions.
model AuditLog {
  id                String   @id @db.Uuid
  /// Null for actions outside any shop (login, registration).
  shopId            String?  @map("shop_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  action            String   @db.VarChar(64)
  entityType        String?  @map("entity_type") @db.VarChar(64)
  entityId          String?  @map("entity_id") @db.Uuid
  before            Json?
  after             Json?
  ip                String?  @db.VarChar(64)
  userAgent         String?  @map("user_agent") @db.VarChar(512)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Fixed-window counters for rate limiting (no Redis; decision A-007).
model RateLimitCounter {
  key         String   @id @db.VarChar(200)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  hits        Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_counters")
}
