// Kariakoo Shop Manager database schema.
//
// Phase 01 deliberately contains no business models. Business tables are
// added phase by phase from docs/architecture/data-model.md.
// Conventions (docs/decisions/decision-register.md, A-008 and D-021):
//   - ids: uuid (v7, generated by the API)
//   - money: Decimal @db.Decimal(18, 2); average cost @db.Decimal(18, 4)
//   - quantities: Decimal @db.Decimal(18, 3)
//   - every shop-owned table has shop_id

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
