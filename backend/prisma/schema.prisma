// Kariakoo Shop Manager database schema.
//
// Tables are added phase by phase from docs/architecture/data-model.md.
// Conventions (docs/decisions/decision-register.md, A-008 and D-021):
//   - ids: uuid (v7, generated by the API)
//   - money: Decimal @db.Decimal(18, 2); average cost @db.Decimal(18, 4)
//   - quantities: Decimal @db.Decimal(18, 3)
//   - every shop-owned table has shop_id

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity and tenancy (Phase 02). docs/architecture/data-model.md section 2.
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Global identity. Not shop-scoped: one person, many shop memberships.
model User {
  id              String     @id @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name") @db.VarChar(120)
  phone           String?    @db.VarChar(32)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(ACTIVE)
  /// Platform operators only; never grantable through shop APIs.
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  authTokens  AuthToken[]
  memberships ShopMembership[]

  @@map("users")
}

/// Server-side session (decision A-003). Only the SHA-256 hash of the cookie
/// token is stored.
model Session {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  /// Set only after the server validated an ACTIVE membership.
  activeShopId  String?   @map("active_shop_id") @db.Uuid
  ip            String?   @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeShop Shop? @relation(fields: [activeShopId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Single-use, time-limited tokens sent by email. Stored as SHA-256 hashes.
model AuthToken {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

enum BusinessType {
  WHOLESALE
  RETAIL
  BOTH
}

enum ShopStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
}

/// The tenant. Every shop-owned table references it through shop_id.
model Shop {
  id                 String       @id @db.Uuid
  name               String       @db.VarChar(120)
  phone              String?      @db.VarChar(32)
  address            String?      @db.VarChar(255)
  businessType       BusinessType @default(BOTH) @map("business_type")
  timezone           String       @default("Africa/Dar_es_Salaam") @db.VarChar(64)
  currency           String       @default("TZS") @db.Char(3)
  status             ShopStatus   @default(ACTIVE)
  /// Owner setting (D-007): sales may take stock below zero. Off by default.
  allowNegativeStock Boolean      @default(false) @map("allow_negative_stock")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          ShopMembership[]
  sessions             Session[]
  auditLogs            AuditLog[]
  roles                Role[]
  invitations          Invitation[]
  subscription         Subscription?
  subscriptionPeriods  SubscriptionPeriod[]
  subscriptionPayments SubscriptionPayment[]
  stockLocations       StockLocation[]
  productCategories    ProductCategory[]
  products             Product[]
  stockAdjustments     StockAdjustment[]

  @@map("shops")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model ShopMembership {
  id        String           @id @db.Uuid
  shopId    String           @map("shop_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  isOwner   Boolean          @default(false) @map("is_owner")
  joinedAt  DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop               Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles              MembershipRole[]
  invitationsCreated Invitation[]

  @@unique([shopId, userId])
  // Target for composite foreign keys (shop_id, membership_id) in later phases.
  @@unique([shopId, id])
  @@index([userId])
  @@map("shop_memberships")
}

// ---------------------------------------------------------------------------
// Authorization and invitations (Phase 03). data-model.md section 3.
// ---------------------------------------------------------------------------

enum PermissionScope {
  SHOP
  PLATFORM
}

/// The permission catalog, seeded by migration from packages/shared
/// (permissions.ts). Read-only to shops.
model Permission {
  code      String          @id @db.VarChar(64)
  module    String          @db.VarChar(32)
  scope     PermissionScope
  /// Only delegable SHOP permissions may be put in a shop's roles.
  delegable Boolean

  roles RolePermission[]

  @@map("permissions")
}

/// A shop's custom role. Owners hold every shop permission through
/// shop_memberships.is_owner, not through a role (decision A-016).
model Role {
  id          String   @id @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  name        String   @db.Citext
  /// Set on the default roles a new shop starts with (manager, cashier...).
  templateKey String?  @map("template_key") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  members     MembershipRole[]
  invitations InvitationRole[]

  @@unique([shopId, name])
  @@unique([shopId, id])
  @@map("roles")
}

model RolePermission {
  shopId         String @map("shop_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code") @db.VarChar(64)

  role       Role       @relation(fields: [shopId, roleId], references: [shopId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@index([shopId])
  @@map("role_permissions")
}

/// Composite keys keep a membership and its roles in the same shop.
model MembershipRole {
  shopId       String   @map("shop_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership ShopMembership @relation(fields: [shopId, membershipId], references: [shopId, id], onDelete: Cascade)
  role       Role           @relation(fields: [shopId, roleId], references: [shopId, id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([shopId, roleId])
  @@map("membership_roles")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Staff invitation by email. The token is stored only as a SHA-256 hash.
/// At most one PENDING invitation per shop and email (enforced by the
/// service under a shop row lock).
model Invitation {
  id                    String           @id @db.Uuid
  shopId                String           @map("shop_id") @db.Uuid
  email                 String           @db.Citext
  tokenHash             String           @unique @map("token_hash") @db.Char(64)
  status                InvitationStatus @default(PENDING)
  invitedByMembershipId String?          @map("invited_by_membership_id") @db.Uuid
  expiresAt             DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt            DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedUserId        String?          @map("accepted_user_id") @db.Uuid
  revokedAt             DateTime?        @map("revoked_at") @db.Timestamptz(3)
  resendCount           Int              @default(0) @map("resend_count")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  invitedBy ShopMembership?  @relation(fields: [invitedByMembershipId], references: [id], onDelete: Restrict)
  roles     InvitationRole[]

  @@unique([shopId, id])
  @@index([shopId, status])
  @@index([shopId, email])
  @@map("invitations")
}

model InvitationRole {
  shopId       String @map("shop_id") @db.Uuid
  invitationId String @map("invitation_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  invitation Invitation @relation(fields: [shopId, invitationId], references: [shopId, id], onDelete: Cascade)
  role       Role       @relation(fields: [shopId, roleId], references: [shopId, id], onDelete: Cascade)

  @@id([invitationId, roleId])
  @@index([shopId, roleId])
  @@map("invitation_roles")
}

// ---------------------------------------------------------------------------
// Reliability and auditing
// ---------------------------------------------------------------------------

/// Append-only record of security-relevant actions.
model AuditLog {
  id                String   @id @db.Uuid
  /// Null for actions outside any shop (login, registration).
  shopId            String?  @map("shop_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  action            String   @db.VarChar(64)
  entityType        String?  @map("entity_type") @db.VarChar(64)
  entityId          String?  @map("entity_id") @db.Uuid
  before            Json?
  after             Json?
  ip                String?  @db.VarChar(64)
  userAgent         String?  @map("user_agent") @db.VarChar(512)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Fixed-window counters for rate limiting (no Redis; decision A-007).
model RateLimitCounter {
  key         String   @id @db.VarChar(200)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  hits        Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Side effects (email) written in the same transaction as the change that
/// caused them and delivered by the outbox worker (decision A-007).
model OutboxMessage {
  id          String       @id @db.Uuid
  shopId      String?      @map("shop_id") @db.Uuid
  type        String       @db.VarChar(64)
  /// Cleared down to non-secret fields once delivered or failed.
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastError   String?      @map("last_error") @db.VarChar(1000)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_messages")
}

// ---------------------------------------------------------------------------
// Plans and subscriptions (Phase 04). docs/architecture/data-model.md
// section 4; decisions D-001, D-005, D-006, D-019.
// ---------------------------------------------------------------------------

enum PlanInterval {
  WEEK
  MONTH
}

/// A price list entry, edited by platform staff. Prices are data, never code.
model Plan {
  id        String       @id @db.Uuid
  code      String       @unique @db.VarChar(40)
  name      String       @db.VarChar(80)
  interval  PlanInterval
  price     Decimal      @db.Decimal(18, 2)
  currency  String       @default("TZS") @db.Char(3)
  active    Boolean      @default(true)
  /// Days of full access after a paid period ends (D-005).
  graceDays Int          @default(3) @map("grace_days")
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  features      PlanFeature[]
  subscriptions Subscription[]
  periods       SubscriptionPeriod[]
  payments      SubscriptionPayment[]

  @@map("plans")
}

/// A feature switch or limit on a plan. A missing row means not included.
model PlanFeature {
  planId     String  @map("plan_id") @db.Uuid
  featureKey String  @map("feature_key") @db.VarChar(40)
  enabled    Boolean @default(true)
  /// For limits (seats, products): null means unlimited.
  limitValue Int?    @map("limit_value")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureKey])
  @@map("plan_features")
}

/// Platform-wide billing settings; a single row with id 1.
model BillingSettings {
  id                  Int      @id @default(1)
  trialDays           Int      @default(14) @map("trial_days")
  reminderDaysBefore  Int      @default(3) @map("reminder_days_before")
  /// Shown to shops paying manually (where to send mobile money).
  paymentInstructions String?  @map("payment_instructions") @db.VarChar(1000)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("billing_settings")
}

/// One per shop (D-001). Status is derived from these dates when read.
model Subscription {
  id          String    @id @db.Uuid
  shopId      String    @unique @map("shop_id") @db.Uuid
  /// The plan of the latest paid period; null while only trialing.
  planId      String?   @map("plan_id") @db.Uuid
  trialEndsAt DateTime  @map("trial_ends_at") @db.Timestamptz(3)
  /// End of the latest confirmed paid period, or null if never paid.
  paidUntil   DateTime? @map("paid_until") @db.Timestamptz(3)
  graceDays   Int       @default(3) @map("grace_days")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop      Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  plan      Plan?                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  periods   SubscriptionPeriod[]
  payments  SubscriptionPayment[]
  reminders SubscriptionReminder[]

  @@unique([shopId, id])
  @@map("subscriptions")
}

/// Paid time added by one confirmed payment. Insert-only, except that a
/// reversal sets reversed_at once (enforced by a trigger).
model SubscriptionPeriod {
  id             String       @id @db.Uuid
  shopId         String       @map("shop_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  planId         String       @map("plan_id") @db.Uuid
  paymentId      String       @unique @map("payment_id") @db.Uuid
  /// The plan's interval when paid, so paid-until can be recomputed after a reversal.
  interval       PlanInterval
  periodStart    DateTime     @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime     @map("period_end") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  reversedAt     DateTime?    @map("reversed_at") @db.Timestamptz(3)

  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  subscription Subscription        @relation(fields: [shopId, subscriptionId], references: [shopId, id], onDelete: Restrict)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment      SubscriptionPayment @relation(fields: [shopId, paymentId], references: [shopId, id], onDelete: Restrict)

  @@unique([shopId, paymentId])
  @@index([subscriptionId, periodEnd])
  @@map("subscription_periods")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

/// A shop's attempt to pay for a plan. Confirmed only by platform staff
/// (manual provider) or a verified provider callback, never by the browser.
model SubscriptionPayment {
  id                String        @id @db.Uuid
  shopId            String        @map("shop_id") @db.Uuid
  subscriptionId    String        @map("subscription_id") @db.Uuid
  planId            String        @map("plan_id") @db.Uuid
  /// Snapshot of the plan price when the payment was started.
  amount            Decimal       @db.Decimal(18, 2)
  currency          String        @db.Char(3)
  provider          String        @db.VarChar(40)
  /// Mobile-money transaction id (manual) or the provider's reference.
  providerReference String        @map("provider_reference") @db.VarChar(100)
  payerPhone        String?       @map("payer_phone") @db.VarChar(32)
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @map("idempotency_key") @db.VarChar(80)
  initiatedByUserId String?       @map("initiated_by_user_id") @db.Uuid
  decidedByUserId   String?       @map("decided_by_user_id") @db.Uuid
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  failedAt          DateTime?     @map("failed_at") @db.Timestamptz(3)
  reversedAt        DateTime?     @map("reversed_at") @db.Timestamptz(3)
  /// Why it failed, was reversed, or needs review (e.g. amount mismatch).
  note              String?       @db.VarChar(500)
  needsReview       Boolean       @default(false) @map("needs_review")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  subscription Subscription        @relation(fields: [shopId, subscriptionId], references: [shopId, id], onDelete: Restrict)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  period       SubscriptionPeriod?
  events       PaymentEvent[]

  @@unique([shopId, id])
  @@unique([provider, providerReference])
  @@unique([shopId, idempotencyKey])
  @@index([status, createdAt])
  @@map("subscription_payments")
}

/// Every provider callback as received, valid or not. Deduplicated by the
/// provider's event id. Global: the shop is only known once verified.
model PaymentEvent {
  id              String    @id @db.Uuid
  provider        String    @db.VarChar(40)
  providerEventId String    @map("provider_event_id") @db.VarChar(120)
  payload         Json
  signatureValid  Boolean   @map("signature_valid")
  outcome         String    @db.VarChar(40)
  paymentId       String?   @map("payment_id") @db.Uuid
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)

  payment SubscriptionPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

/// Records each expiry reminder sent, so it is sent once per paid-until date.
model SubscriptionReminder {
  subscriptionId String   @map("subscription_id") @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  kind           String   @db.VarChar(20)
  dueAt          DateTime @map("due_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, kind, dueAt])
  @@map("subscription_reminders")
}

// ---------------------------------------------------------------------------
// Products and inventory (Phase 05). docs/architecture/data-model.md
// sections 5, 6 and 12; decisions D-002, D-003, D-007, D-013, D-021.
// ---------------------------------------------------------------------------

/// Where stock is kept. One default location per shop for now (D-002); the
/// column is on every balance and movement so branches can come later.
model StockLocation {
  id        String   @id @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String   @db.VarChar(80)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  balances  StockBalance[]
  movements StockMovement[]

  @@unique([shopId, id])
  @@unique([shopId, name])
  @@map("stock_locations")
}

model ProductCategory {
  id         String    @id @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  name       String    @db.Citext
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([shopId, id])
  @@unique([shopId, name])
  @@map("product_categories")
}

/// A product. Stock is counted in its base unit (the unit with
/// is_base = true); other units convert to it.
model Product {
  id                    String    @id @db.Uuid
  shopId                String    @map("shop_id") @db.Uuid
  categoryId            String?   @map("category_id") @db.Uuid
  name                  String    @db.VarChar(160)
  /// Optional shop code; unique within the shop when set.
  sku                   String?   @db.Citext
  /// Low-stock alert when the base quantity is at or below this.
  reorderLevel          Decimal?  @map("reorder_level") @db.Decimal(18, 3)
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(3)
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category  ProductCategory? @relation(fields: [shopId, categoryId], references: [shopId, id], onDelete: Restrict)
  units     ProductUnit[]
  balances  StockBalance[]
  movements StockMovement[]

  @@unique([shopId, id])
  @@unique([shopId, sku])
  @@index([shopId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

/// A unit a product is counted, bought or sold in ("piece", "carton").
/// conversion = base units in one of this unit. The conversion and the base
/// flag never change once created (trigger), so history stays correct.
model ProductUnit {
  id             String    @id @db.Uuid
  shopId         String    @map("shop_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  name           String    @db.Citext
  conversion     Decimal   @db.Decimal(18, 3)
  isBase         Boolean   @default(false) @map("is_base")
  /// Whether quantities in this unit may have decimals (D-013, up to 3).
  allowFraction  Boolean   @default(false) @map("allow_fraction")
  barcode        String?   @db.VarChar(64)
  /// Prices per one of this unit, whole shillings stored as numeric(18,2) (D-021).
  buyingPrice    Decimal?  @map("buying_price") @db.Decimal(18, 2)
  retailPrice    Decimal?  @map("retail_price") @db.Decimal(18, 2)
  wholesalePrice Decimal?  @map("wholesale_price") @db.Decimal(18, 2)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product         @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Restrict)
  priceHistory PriceHistory[]
  movements    StockMovement[]

  @@unique([shopId, id])
  @@unique([productId, name])
  @@unique([shopId, barcode])
  @@index([shopId, productId])
  @@map("product_units")
}

/// Every price set or changed, append-only (trigger).
model PriceHistory {
  id                    String   @id @db.Uuid
  shopId                String   @map("shop_id") @db.Uuid
  productUnitId         String   @map("product_unit_id") @db.Uuid
  buyingPrice           Decimal? @map("buying_price") @db.Decimal(18, 2)
  retailPrice           Decimal? @map("retail_price") @db.Decimal(18, 2)
  wholesalePrice        Decimal? @map("wholesale_price") @db.Decimal(18, 2)
  changedByMembershipId String?  @map("changed_by_membership_id") @db.Uuid
  changedAt             DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  unit ProductUnit @relation(fields: [shopId, productUnitId], references: [shopId, id], onDelete: Restrict)

  @@index([shopId, productUnitId, changedAt])
  @@map("price_history")
}

/// Current stock of a product at a location, in base units. Changed only by
/// the inventory service, always together with a stock movement; the
/// reconciliation check compares it with the sum of movements.
model StockBalance {
  shopId      String   @map("shop_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(18, 3)
  /// Weighted-average cost per base unit (D-003), 4 decimals.
  averageCost Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product  Product       @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Restrict)
  location StockLocation @relation(fields: [shopId, locationId], references: [shopId, id], onDelete: Restrict)

  @@id([shopId, productId, locationId])
  @@map("stock_balances")
}

enum StockMovementType {
  OPENING
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum AdjustmentReason {
  COUNT_CORRECTION
  DAMAGED
  EXPIRED
  LOST
  FOUND
  OWN_USE
  OTHER
}

/// A stock adjustment request (WF-06). Its stock change is the movement
/// that points at it. Append-only.
model StockAdjustment {
  id                    String           @id @db.Uuid
  shopId                String           @map("shop_id") @db.Uuid
  reason                AdjustmentReason
  note                  String?          @db.VarChar(500)
  idempotencyKey        String           @map("idempotency_key") @db.VarChar(80)
  /// Hash of the request, so a reused key with different content is refused.
  requestHash           String           @map("request_hash") @db.Char(64)
  createdByMembershipId String           @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([shopId, id])
  @@unique([shopId, idempotencyKey])
  @@map("stock_adjustments")
}

/// The stock ledger: every change to a balance, signed, in base units, with
/// the unit and conversion as entered. Append-only (trigger).
model StockMovement {
  id                    String            @id @db.Uuid
  shopId                String            @map("shop_id") @db.Uuid
  productId             String            @map("product_id") @db.Uuid
  locationId            String            @map("location_id") @db.Uuid
  type                  StockMovementType
  /// Signed change in base units (+ in, - out).
  quantity              Decimal           @db.Decimal(18, 3)
  /// Balance after this movement, for history and reconciliation.
  balanceAfter          Decimal           @map("balance_after") @db.Decimal(18, 3)
  /// Cost per base unit used for this movement (D-003).
  unitCost              Decimal           @map("unit_cost") @db.Decimal(18, 4)
  /// Unit, quantity and conversion as entered (snapshot). For a stock count
  /// the quantity is the counted amount, which may be zero.
  unitId                String            @map("unit_id") @db.Uuid
  unitName              String            @map("unit_name") @db.VarChar(40)
  unitQuantity          Decimal           @map("unit_quantity") @db.Decimal(18, 3)
  conversion            Decimal           @db.Decimal(18, 3)
  adjustmentId          String?           @map("adjustment_id") @db.Uuid
  reason                AdjustmentReason?
  note                  String?           @db.VarChar(500)
  createdByMembershipId String            @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product    Product          @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Restrict)
  location   StockLocation    @relation(fields: [shopId, locationId], references: [shopId, id], onDelete: Restrict)
  unit       ProductUnit      @relation(fields: [shopId, unitId], references: [shopId, id], onDelete: Restrict)
  adjustment StockAdjustment? @relation(fields: [shopId, adjustmentId], references: [shopId, id], onDelete: Restrict)

  @@index([shopId, productId, createdAt])
  @@index([shopId, createdAt])
  @@map("stock_movements")
}
